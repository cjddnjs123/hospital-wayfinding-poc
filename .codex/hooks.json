{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|exec_command|local_shell|Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.cursor/hooks/boot-gate.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|read_file|Bash|shell|exec_command|local_shell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.cursor/hooks/boot-gate.py\""
          }
        ]
      }
    ]
  }
}
